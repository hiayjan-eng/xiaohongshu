{
  "manifest_version": 3,
  "name": "收藏复活旧收藏扫描 Beta",
  "version": "0.4.2",
  "version_name": "0.4.2-m0-api-spike",
  "description": "在用户主动点击后，扫描本人小红书网页版当前已加载收藏卡片，支持进度反馈、暂停继续、断点恢复和导入前确认。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://xiaohongshu-green.vercel.app/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*"
  ],
  "action": {
    "default_title": "收藏复活全量扫描"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xiaohongshu-green.vercel.app/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "src/build-profile.js",
        "src/web-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "src/full-scan-core.js",
        "src/xhs-scanner.js",
        "src/full-scan-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": ["src/api-sync/api-probe-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": ["src/api-sync/api-probe-content.js"],
      "run_at": "document_start"
    }
  ]
}
