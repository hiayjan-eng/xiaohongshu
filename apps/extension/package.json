{
  "name": "@revival/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Collection Revival browser extension Beta and M0 full-scan technical spike.",
  "scripts": {
    "typecheck": "node ./scripts/validate-api-sync-spike.mjs",
    "test:api-sync": "node ./scripts/run-api-sync-spike.mjs",
    "test:dom": "node ./scripts/validate-extension.mjs",
    "test:full-scan-spike": "node ./scripts/run-full-scan-spike.mjs",
    "test:profiles": "node ./scripts/verify-extension-profiles.mjs",
    "build": "node ./scripts/build-extension.mjs && node ./scripts/validate-chromium-load.mjs",
    "build:preview": "node ./scripts/build-extension.mjs --preview",
    "test:m0:fixtures": "node ./scripts/run-full-scan-spike.mjs",
    "test:m0:premature-completion": "node ./scripts/run-premature-completion-regression.mjs",
    "test:m0:root-boundary": "node ./scripts/run-root-boundary-regression.mjs",
    "test:m0:page-identity": "node ./scripts/run-m0-preview-integration.mjs --suite=page-identity",
    "test:m0:side-panel": "node ./scripts/run-m0-preview-integration.mjs --suite=side-panel",
    "test:m0:import-bridge": "node ./scripts/run-m0-preview-integration.mjs --suite=import-bridge",
    "test:m0:batch-rollback": "node ./scripts/run-m0-preview-integration.mjs --suite=batch-rollback",
    "test:m0:original-link": "node ./scripts/run-m0-preview-integration.mjs --suite=original-link",
    "test:m0:preview-namespace": "node ./scripts/run-m0-preview-integration.mjs --suite=preview-namespace",
    "test:m0:integration": "node ./scripts/run-m0-preview-integration.mjs --suite=all",
    "build:m0-preview": "node ./scripts/build-extension.mjs --m0-preview"
  }
}
